<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Отель — Корзина</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"></head><body><header><div class="container header-inner"><a href="/" class="logo">Отель</a><button class="burger-btn"><i class="fas fa-bars"></i></button><button class="theme-toggle" type="button"><i class="fas fa-moon"></i></button><nav class="nav-menu"><a href="/">Номера</a><a href="/guests">Гости</a><a href="/rooms">База номеров</a><a href="/bookings/getCart" class="btn-cart">Бронирование</a></nav></div></header><main class="cart-page"><div class="container"><h1 class="page-title">Ваша бронь</h1>{{#if cartRooms.length}}<div class="cart-grid"><div class="cart-items">{{#each cartRooms}}<div class="cart-item"><div class="cart-item-content"><img src="{{roomImage this.TypeName}}" alt="{{this.TypeName}}" class="cart-item-image"><div class="cart-item-info"><div class="cart-item-header"><h3 class="cart-item-title">{{this.TypeName}} №{{this.RoomNumber}}</h3><a class="cart-item-delete" href="/bookings/remove/{{@index}}" title="Удалить"><i class="fas fa-trash"></i></a></div><div class="cart-item-details"><div class="detail-item"><i class="fas fa-calendar"></i><span>{{formatDate this.checkIn}} — {{formatDate this.checkOut}}</span></div><div class="detail-item"><i class="fas fa-user"></i><span>{{this.guests}} гостей</span></div><div class="detail-item"><i class="fas fa-moon"></i><span>{{nights this.checkIn this.checkOut}} ноч.</span></div></div><div class="cart-item-price">{{money this.Price}} × {{nights this.checkIn this.checkOut}} ноч.</div><div class="cart-item-total">{{money (multiply this.Price (nights this.checkIn this.checkOut))}}</div></div></div></div>{{/each}}</div><aside class="cart-summary"><h3 class="cart-summary-title">Итого</h3>{{#each cartRooms}}<div class="summary-row"><span class="text-muted">{{this.TypeName}}</span><span>{{money (multiply this.Price (nights this.checkIn this.checkOut))}}</span></div>{{/each}}<div class="cart-summary-total"><span>Итого:</span><span class="total-price">{{money totalPrice}}</span></div><a href="/bookings/checkout" class="btn-primary full-width">Оформить бронирование</a></aside></div>{{else}}<p style="text-align:center; padding:40px; color:var(--text-muted);">Ваша корзина пуста.<br><a href="/" style="color:var(--primary);display:inline-block;margin-top:10px;">Перейти к выбору номеров</a></p>{{/if}}</div></main><script src="/js/script.js"></script></body></html>
