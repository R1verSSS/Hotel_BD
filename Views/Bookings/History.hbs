<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>История</title><link rel="stylesheet" href="/css/style.css"></head><body><main class="checkout-page"><div class="container"><h1 class="page-title">История бронирований</h1>{{#if History.length}}<div class="checkout-form"><table style="width:100%; border-collapse:collapse;"><tr><th>№</th><th>Гость</th><th>Номер</th><th>Тип</th><th>Заезд</th><th>Выезд</th><th>Сумма</th></tr>{{#each History}}<tr><td>{{this.BookingId}}</td><td>{{this.FullName}}</td><td>{{this.RoomNumber}}</td><td>{{this.TypeName}}</td><td>{{this.CheckIn}}</td><td>{{this.CheckOut}}</td><td>{{money this.TotalPrice}}</td></tr>{{/each}}</table></div>{{else}}<div class="cart-item"><p>История пуста.</p></div>{{/if}}<p style="margin-top:20px"><a href="/guests">← К списку гостей</a></p></div></main></body></html>
