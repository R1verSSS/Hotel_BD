<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Гости</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"></head><body>
<header><div class="container header-inner"><a href="/" class="logo">Отель</a><button class="burger-btn" type="button"><i class="fas fa-bars"></i></button><button class="theme-toggle" type="button"><i class="fas fa-moon"></i></button><nav class="nav-menu"><a href="/rooms">Номера</a><a href="/guests">Гости</a><a href="/bookings/getCart" class="btn-cart">Бронирование</a></nav></div></header>
<main class="checkout-page"><div class="container"><h1 class="page-title">Список гостей</h1><form class="rooms-filters" action="/guests" method="GET"><div class="filter-group"><label>Поиск по фамилии</label><input class="filter-control" type="text" name="surname" value="{{curSurname}}" placeholder="Введите начало фамилии..."></div><button class="filter-reset" type="submit">Найти</button><a href="/guests/add" class="btn-primary full-width">+ Добавить гостя</a></form><div class="checkout-form"><table style="width:100%; border-collapse:collapse;"><tr><th>ID</th><th>ФИО</th><th>Паспорт</th><th>Телефон</th><th>Адрес</th><th>Действия</th></tr>{{#each Guests}}<tr><td>{{this.GuestId}}</td><td>{{this.FullName}}</td><td>{{this.Passport}}</td><td>{{this.Phone}}</td><td>{{this.Address}}</td><td><a href="/guests/edit/{{this.GuestId}}">Редактировать</a> | <a href="/bookings/getHistory/{{this.GuestId}}">История</a></td></tr>{{/each}}</table></div></div></main><script src="/js/script.js"></script></body></html>
