<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Редактирование гостя</title>
</head>
<body>
    <h2>️ Редактирование данных гостя</h2>
    <form action="/guests/postEdit" method="POST">
        <input type="hidden" name="GuestId" value="{{guest.GuestId}}">
        
        <label>ФИО:</label><br>
        <input name="FullName" type="text" value="{{guest.FullName}}" readonly style="background:#eee;"><br><br>
        
        <label>Телефон:</label><br>
        <input name="Phone" type="tel" value="{{guest.Phone}}" required><br><br>
        
        <label>Адрес:</label><br>
        <input name="Address" type="text" value="{{guest.Address}}" required><br><br>

        <button type="submit">Сохранить изменения</button>
    </form>
    <p><a href="/guests">← К списку гостей</a></p>
</body>
</html>