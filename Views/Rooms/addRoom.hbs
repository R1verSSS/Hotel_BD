<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Добавление номера</title><link rel="stylesheet" href="/css/style.css"></head><body><main class="checkout-page"><div class="container"><h1 class="page-title">Добавление нового номера</h1><form class="checkout-form" action="/rooms/postAdd" method="POST"><div class="form-group"><label class="form-label">Номер комнаты</label><input class="form-input" name="RoomNumber" type="text" required></div><div class="form-group"><label class="form-label">Тип номера</label><select class="form-select" name="TypeId" required>{{#each RoomTypes}}<option value="{{this.TypeId}}">{{this.TypeName}}</option>{{/each}}</select></div><div class="form-group"><label class="form-label">Оснащение</label><select class="form-select" name="FeatureId" required>{{#each RoomFeatures}}<option value="{{this.FeatureId}}">{{this.FeatureName}}</option>{{/each}}</select></div><div class="form-group"><label class="form-label">Цена за ночь</label><input class="form-input" name="Price" type="number" step="0.01" required></div><button class="btn-primary" type="submit">Сохранить</button></form><p style="margin-top:20px"><a href="/rooms">← Назад к номерам</a></p></div></main></body></html>
