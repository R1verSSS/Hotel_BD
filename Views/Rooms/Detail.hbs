<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Отель - Номер {{typeName}}</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css"></head><body>
<header><div class="container header-inner"><a href="/" class="logo">Отель</a><button class="burger-btn" type="button"><i class="fas fa-bars"></i></button><button class="theme-toggle" type="button" aria-label="Переключить тёмную тему"><i class="fas fa-moon"></i></button><nav class="nav-menu"><a href="/#rooms">Номера</a><a href="/#services">Услуги</a><a href="/#about">О нас</a><a href="/#contacts">Контакты</a><a href="/bookings/getCart" class="btn-cart">Бронирование</a></nav></div></header>
<main class="room-page"><div class="container"><div class="room-detail-grid"><div class="room-gallery-section"><div class="main-image-container"><img src="{{main}}" alt="{{typeName}}" class="main-image" id="mainImage"></div><div class="thumbnails-container"><img src="{{main}}" alt="Фото 1" class="thumbnail active" onclick="changeImage(this)"><img src="{{a1}}" alt="Фото 2" class="thumbnail" onclick="changeImage(this)"><img src="{{a2}}" alt="Фото 3" class="thumbnail" onclick="changeImage(this)"><img src="{{bath}}" alt="Фото 4" class="thumbnail" onclick="changeImage(this)"></div></div><div class="room-info-section"><h1 class="room-detail-title">{{typeName}}</h1><p class="room-detail-description">{{description}}</p><div class="room-detail-price"><span class="price-value">{{money price}}</span><span class="price-period">за ночь</span></div><div class="room-specs"><div class="spec-item"><i class="fas fa-user-friends"></i><div><span class="spec-label">Вместимость</span><span class="spec-value">{{guests}} гостя</span></div></div><div class="spec-item"><i class="fas fa-maximize"></i><div><span class="spec-label">Площадь</span><span class="spec-value">{{area}} м²</span></div></div></div><div class="room-amenities"><h3 class="amenities-title">Удобства:</h3><div class="amenities-grid"><div class="amenity-item"><i class="fas fa-wifi"></i><span>Wi-Fi</span></div><div class="amenity-item"><i class="fas fa-tv"></i><span>Телевизор</span></div><div class="amenity-item"><i class="fas fa-wind"></i><span>Кондиционер</span></div><div class="amenity-item"><i class="fas fa-coffee"></i><span>Мини-бар</span></div></div></div><div class="booking-form-card" data-type-name="{{typeName}}" data-price="{{price}}" data-image="{{mini}}"><h3 class="form-title">Забронировать номер</h3><div class="form-group"><label class="form-label">Заезд</label><input type="text" placeholder="дд.мм.гггг" class="form-input check-in" readonly></div><div class="form-group"><label class="form-label">Выезд</label><input type="text" placeholder="дд.мм.гггг" class="form-input check-out" readonly></div><div class="form-group"><label class="form-label">Количество гостей</label><select class="form-select guests-select">{{#if (eq guests 4)}}<option value="1">1 гость</option><option value="2" selected>2 гостя</option><option value="3">3 гостя</option><option value="4">4 гостя</option>{{else}}<option value="1">1 гость</option><option value="2" selected>2 гостя</option>{{/if}}</select></div><div class="booking-live-total" id="booking-live-total"><div class="booking-live-label">Предварительная стоимость</div><div class="booking-live-price">Выберите даты</div><div class="booking-live-note">Минимальная стоимость — 1 ночь</div></div><button type="button" class="btn-primary btn-full js-add-to-cart">Добавить в бронь</button></div></div></div></div></main>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script><script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ru.js"></script><script src="/js/script.js"></script></body></html>
